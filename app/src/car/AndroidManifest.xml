<?xml version="1.0" encoding="utf-8"?>
<!-- Fassung für Autos mit eingebautem Android (Android Automotive OS). Video nur im Stand: Die Seiten sind
     nicht als ablenkungsfrei gekennzeichnet, das Auto blendet sie während der Fahrt aus und der Player stoppt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <application>
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
